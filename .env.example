# Discord Bot Credentials
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_GUILD_ID=your_server_id_optional

# Channel Lock & Roster Role Configuration
COORDINATION_CHANNEL=5-stackers
ROSTER_ROLE=LOLers

# Schedule & Timezone Configuration
SERVER_TIMEZONE=America/Vancouver
RANKED_5S_START_HOUR=20
RANKED_5S_END_HOUR=1

# Riot Games Developer API Configuration
# Get your API key from https://developer.riotgames.com/
RIOT_API_KEY=RGAPI-your-riot-api-key-here
# Routing region: americas, europe, asia, sea
RIOT_REGION=americas
# Auto tracking polling interval in minutes (default: 2)
AUTO_TRACKING_INTERVAL_MINUTES=2

